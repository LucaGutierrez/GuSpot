# Opcional. URL de un estilo de mapa compatible con MapLibre.
# Si no se define, se usa OpenFreeMap (solo apto para la demo: sin SLA).
# NEXT_PUBLIC_MAP_STYLE_URL=

# Supabase (cuentas y garages reales). Sin estas dos variables la app funciona
# en modo demo. Son valores PÚBLICOS: URL del proyecto y clave "publishable"
# (sb_publishable_…). NUNCA poner acá una clave secreta (sb_secret_…).
# Copiar este archivo como .env.local y completar.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
